rowwise() |>
mutate(
ds = list(seq.Date(start_date, census_date, by = "day"))
) |>
ungroup() |>
select(term, ds) |>
rename(holiday = term) |>
mutate(lower_window = 0, upper_window = 0) |>
unnest(ds)
