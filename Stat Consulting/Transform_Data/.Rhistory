mutate(day_seq = row_number()) %>%         # Create a sequential index for the observed days.
# Re-base the index so that the most recent observation becomes 0.
mutate(days_after_first = day_seq - 1) %>%
ungroup() %>%
select(-day_seq)
start_next_index <- as.numeric(start_next - registration_date_next + max(shifted_data$days_after_first))
two_weeks_before_next_index <- as.numeric(start_next_index - 14)
census_date_next_index <- as.numeric(census_date_next - registration_date_next + max(shifted_data$days_after_first))
full_shifted_data <- shifted_data %>%
mutate(
start_next_index = as.numeric(start_next_index),
two_weeks_before_next_index = as.numeric(two_weeks_before_next_index),
census_date_next_index = as.numeric(census_date_next_index)
)
top_six_bigger_class <- full_shifted_data |>
filter(catalog_number %in% c("1010", "1401", "2830", "2411", "1060", "1110"))
# Filter data for every big class offered
calc1_data <- top_six_bigger_class |>
filter(catalog_number == "1401")
math_for_liberal_data <- top_six_bigger_class |>
filter(catalog_number == "1010")
intro_stats_data <- top_six_bigger_class |>
filter(catalog_number == "2830")
calc2_data <- top_six_bigger_class |>
filter(catalog_number == "2411")
finite_math <- top_six_bigger_class |>
filter(catalog_number == "1060")
college_algebra_data <- top_six_bigger_class |>
filter(catalog_number == "1110")
calc1_all_graph <- calc1_data |>
ggplot( aes(x = days_after_first, y = total_of_enrollments)) +
geom_area(fill="red", alpha=0.5) +
geom_line(color="red") +
labs(
title = "Enrollment Over Time for Calculus I (MATH 1401)",
x = "Date",
y = "Enrollment Total"
) +
theme_minimal()
calc1_all_graph
calc1_series <- ts(calc1_data$total_of_enrollments, frequency = 1)
calc1_series %>% diff(lag=4) %>% ggtsdisplay()
sarima_model <- Arima(calc1_series, order = c(2,1,0))
summary(sarima_model)
sarima_forecast <- forecast(sarima_model, h = 200)
# Plot the forecast.
plot(sarima_forecast, main = "SARIMA Forecast of Enrollment", ylab = "Enrollment", xlab = "Time")
