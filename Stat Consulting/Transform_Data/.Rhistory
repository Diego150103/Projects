calc1_data_spring <- calc1_data_spring %>%
mutate(year = as.integer(str_extract(term, "\\d{4}")))
# Find the maximum (most recent) spring year.
max_spring_year <- max(calc1_data_spring$year, na.rm = TRUE)
# Then, filter for the previous spring year.
calc1_data_prev_spring <- calc1_data_spring %>%
filter(year == max_spring_year - 1) %>%
select(-year)
calc1_series_prev_spring <- ts(calc1_data_prev_spring$total_of_enrollments, frequency = 1)
sarima_model_prev_spring <- auto.arima(calc1_series_prev_spring, seasonal = T)
sarima_forecast_prev_spring <- forecast(sarima_model_prev_spring, h = 200)
# Plot the forecast.
plot(sarima_forecast_prev_spring, main = "SARIMA Forecast of Enrollment", ylab = "Enrollment", xlab = "Time")
calc1_data_fall <- calc1_data_fall %>%
mutate(year = as.integer(str_extract(term, "\\d{4}")))
# Find the maximum fall year.
max_fall_year <- max(calc1_data_fall$year, na.rm = TRUE)
# Filter for the previous fall year.
calc1_data_prev_fall <- calc1_data_fall %>%
filter(year == max_fall_year - 1) %>%
select(-year)
calc1_series_prev_fall <- ts(calc1_data_prev_fall$total_of_enrollments, frequency = 1)
sarima_model_prev_fall <- auto.arima(calc1_series_prev_fall, seasonal = T)
sarima_forecast_prev_fall <- forecast(sarima_model_prev_fall, h = 200)
# Plot the forecast.
plot(sarima_forecast_prev_fall, main = "SARIMA Forecast of Enrollment", ylab = "Enrollment", xlab = "Time")
